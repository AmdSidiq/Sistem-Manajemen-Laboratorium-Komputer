<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pbo.sistemmanajemenlab.SecondaryController">
    <children>
        <Label text="Daftar Peralatan Lab" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
        <Label text="(Kelola peralatan melalui menu terminal)" />
        <Button fx:id="secondaryButton" text="Kembali ke Halaman Utama" onAction="#switchToPrimary"/>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
</VBox>
